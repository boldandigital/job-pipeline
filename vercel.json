{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "web/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/web/static/marketing.html"
    },
    {
      "src": "/signup",
      "dest": "/web/static/signup.html"
    },
    {
      "src": "/verify",
      "dest": "/web/static/verify.html"
    },
    {
      "src": "/login",
      "dest": "/web/static/login.html"
    },
    {
      "src": "/web/static/(.*)",
      "dest": "/web/static/$1"
    },
    {
      "src": "/(.*)\\.(html|css|js|svg|png|ico|woff2|webp)",
      "dest": "/web/static/$1.$2"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|svg|png|ico|woff2|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
