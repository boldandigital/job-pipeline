# LLM API (required for scoring and cover letter generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Proxy for scraping (optional, recommended for Indeed)
PROXY_URL=http://user:pass@proxy-host:port

# Database paths (defaults to ./data/)
DB_PATH=./data/jobs.db
JOBSPY_DB_PATH=./data/jobspy.db

# CV Generator
PHOTO_PATH=./config/photo.png
CANDIDATE_PROFILE=./config/candidate_profile.md
