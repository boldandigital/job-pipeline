# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  JOB SEARCH PIPELINE — environment variables                         ║
# ║  Copy this file to `.env` and fill in real values. `.env` is gitignored.║
# ║  ⚓ Used by: batch_pipeline.py, daily_pipeline.sh, cron job            ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ───────────────────────────────────────────────────────────────────────
# LLM API (REQUIRED for scoring + cover letter generation)
# ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# ───────────────────────────────────────────────────────────────────────
# Telegram notifications (REQUIRED for daily delivery)
# Create the bot via @BotFather on Telegram, then start a chat with it
# so the bot can message you. chat_id = your numeric user id.
# ───────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-me-via-botfather
TELEGRAM_CHAT_ID=replace-me-your-chat-id

# ───────────────────────────────────────────────────────────────────────
# Candidate profile (Lars Zimmermann, used by ATS cover-letter templates)
# ───────────────────────────────────────────────────────────────────────
CANDIDATE_NAME=Lars Zimmermann
CANDIDATE_TITLE=Serial Founder & CTO
CANDIDATE_LOCATION=Brussels, Belgium (open to DACH remote)
CANDIDATE_EMAIL=lars.z@icloud.com
CANDIDATE_PHONE=+32 4xx xx xx xx
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/lars-zimmermann/

# ───────────────────────────────────────────────────────────────────────
# CV Generator
# ───────────────────────────────────────────────────────────────────────
PHOTO_PATH=./config/photo.png
CANDIDATE_PROFILE=./config/candidate_profile.md

# ───────────────────────────────────────────────────────────────────────
# Proxy for scraping (optional, recommended for Indeed)
# ───────────────────────────────────────────────────────────────────────
# PROXY_URL=http://user:pass@proxy-host:12321

# ───────────────────────────────────────────────────────────────────────
# Database paths (defaults to ./data/)
# ───────────────────────────────────────────────────────────────────────
DB_PATH=./data/jobs.db
JOBSPY_DB_PATH=./data/jobspy.db

# ───────────────────────────────────────────────────────────────────────
# Pipeline tuning
# ───────────────────────────────────────────────────────────────────────
# Set to 1 to use our ATS-safe templates + 4-track WHY-YOU YAML (default).
# Set to 0 to fall back to dome317's stock cover_letter_generator.py.
USE_ATS_TEMPLATES=1
